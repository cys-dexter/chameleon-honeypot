[Unit]
Description=Chameleon Cyber Deception & Psychological Tarpit Service
After=network.target network-online.target
Wants=network-online.target
Documentation=man:chameleon(8)

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chameleon-honeypot
ExecStart=/opt/chameleon-honeypot/bin/chameleon -c /opt/chameleon-honeypot/config/config.json
Restart=always
RestartSec=5s

# File descriptor limits for high concurrency decoy socket handling
LimitNOFILE=65535
LimitNPROC=4096

# Process isolation & security hardening
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Standard logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chameleon-honeypot

[Install]
WantedBy=multi-user.target
